{
  "name": "@cyanmycelium/mcp-web-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "npm run build -w @cyanmycelium/mcp-web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env packages/mcp-web/dist/cli.js",
    "format": "prettier --check \"packages/*/src/**/*.ts\" \"tests/**/*.ts\"",
    "format:fix": "prettier --write \"packages/*/src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9"
  }
}
